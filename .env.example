# ===================================================
# PersonalGrowth 系统环境配置文件
# ===================================================

# ----------------- 1. Telegram Bot 配置 -----------------
# 从 Telegram 官方 @BotFather 创建机器人获取的 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 访问白名单（逗号分隔的 Telegram 数字 User ID）
#   填你自己的 ID  -> 私有模式：仅白名单用户可用（推荐自建自用）
#   填 "*"        -> 公开模式：对所有 Telegram 用户开放
#   留空          -> 公开模式，但启动时会打印警告（不推荐）
# 获取 ID 的方式：启动后给机器人发送 /id
#
# ⚠️ 重要：只有【私有模式（配置了白名单）】下，下面的全局 LLM Key 才会作为
#    白名单用户的兜底 Key 生效。公开模式下不会兜底，每位用户必须自行 /setkey，
#    否则陌生用户会消耗你自己的 API 额度。
ALLOWED_USER_IDS=123456789

# 本地运行若在大陆网络，需配置代理 (可选, 如使用 Clash/Surge)
# TELEGRAM_PROXY=http://127.0.0.1:7890

# ----------------- 2. LLM 大模型配置 -----------------
# 默认使用的模型提供商: gemini 或 openai（用户也可在对话中用 /switch 切换）
DEFAULT_LLM_PROVIDER=gemini

# [Gemini 配置]
# 私有模式下作为白名单用户的兜底 Key；用户也可以用 /setkey gemini <key> 覆盖
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# [OpenAI 兼容接口配置] (DeepSeek / 硅基流动 / OneAPI 等)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_VISION_MODEL=deepseek-chat
# OPENAI_WHISPER_MODEL=whisper-1

# ----------------- 3. 定时复盘计划 -----------------
# 每日复盘触发时间 (24小时制 HH:MM)
DAILY_REVIEW_TIME=23:00

# 周度战略复盘触发时间 (mon-sun)
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=22:00

# 时区
TIMEZONE=Asia/Shanghai
