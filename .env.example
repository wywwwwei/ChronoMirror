# ===================================================
# PersonalGrowth 系统环境配置文件
# ===================================================

# ----------------- 1. Telegram Bot 配置 -----------------
# 从 Telegram 官方 @BotFather 创建机器人获取的 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 允许访问的 Telegram 用户 ID（必填，防止其他人乱动你的复盘）
# 启动后可通过给机器人发 /id 或在终端中获取
ALLOWED_USER_IDS=123456789

# 本地运行若在大陆网络，需配置代理 (可选, 如使用 Clash/Surge)
# TELEGRAM_PROXY=http://127.0.0.1:7890

# ----------------- 2. LLM 大模型配置 -----------------
# 默认使用的模型提供商: gemini 或 openai
DEFAULT_LLM_PROVIDER=gemini

# [Gemini 配置] (初期使用)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# [OpenAI 兼容接口配置] (后期切换或使用 DeepSeek / 硅基流动 / OneAPI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1

# ----------------- 3. 定时复盘计划 -----------------
# 每日复盘触发时间 (24小时制 HH:MM)
DAILY_REVIEW_TIME=23:00

# 周度战略复盘触发时间 (mon-sun)
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=22:00

# 时区
TIMEZONE=Asia/Shanghai
