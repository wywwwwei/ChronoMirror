# Environments & Python Cache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Sensitive Environment Variables (Never commit!)
.env
*.env.local

# IDE & OS
.DS_Store
.idea/
.vscode/

# Vault User Privacy Data (绝对保护用户个人隐私与API Key)
vault/logs/*.md
vault/attachments/*
vault/reviews/daily/*.md
vault/reviews/weekly/*.md

# 多用户隔离数据保护
vault/users/*/logs/*.md
vault/users/*/attachments/*
vault/users/*/reviews/**/*.md
vault/users/*/config.json

# 保留目录结构与占位符
!.gitkeep
!vault/**/.gitkeep
