# Environments & Python Cache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Sensitive Environment Variables (Never commit!)
# 覆盖所有变体（.env / .env.prod / .env.bak / .env.save ...），仅保留模板
.env
.env.*
!.env.example
*.env.local

# IDE & OS
.DS_Store
.idea/
.vscode/

# Vault User Privacy Data (绝对保护用户个人隐私与API Key)
vault/logs/*.md
vault/attachments/*
vault/reviews/daily/*.md
vault/reviews/weekly/*.md

# 多用户隔离数据保护 (彻底忽略所有用户文件夹)
vault/users/*
!vault/users/.gitkeep

# 保留目录结构与占位符
!.gitkeep
!vault/**/.gitkeep
